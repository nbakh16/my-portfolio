---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { GalleryImage } from '../utils/images';

interface Props {
  images: GalleryImage[];
  captions?: Record<string, string>;
  title: string;
}

const { images, captions = {}, title } = Astro.props;

const items = images.map((image, index) => ({
  src: image.src,
  alt: captions[image.filename] ?? `${title} screenshot ${index + 1}`,
  caption: captions[image.filename] ?? '',
}));
---

{items.length > 0 && (
  <section class="mt-16" aria-label={`${title} screenshots`}>
    <h2 class="text-2xl md:text-3xl font-heading font-bold text-maintext mb-6 flex items-center gap-3">
      <span class="text-accent">/</span> Screenshots
    </h2>

    <div id="project-gallery" class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {items.map((item, index) => (
        <button
          type="button"
          class="gallery-thumb group block aspect-video overflow-hidden rounded-xl bg-accent/5 border border-accent/10 hover:border-accent/40 transition-all duration-300 cursor-pointer"
          data-index={index}
          aria-label={`Open screenshot ${index + 1}: ${item.alt}`}
        >
          <Image
            src={item.src}
            alt={item.alt}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </button>
      ))}
    </div>

    <!-- Lightbox -->
    <dialog
      id="gallery-lightbox"
      class="backdrop:bg-black/80 backdrop:backdrop-blur-sm bg-transparent p-0 m-auto max-w-[95vw] max-h-[95vh] w-full border-0 outline-none"
    >
      <div class="relative flex flex-col items-center gap-3">
        <button
          type="button"
          id="lightbox-close"
          class="absolute -top-2 right-0 md:-top-3 md:-right-3 z-10 p-2 rounded-full bg-background border border-accent/20 text-accent hover:border-accent/60 transition-colors duration-300 cursor-pointer"
          aria-label="Close"
        >
          <Icon name="mdi:close" class="w-5 h-5" />
        </button>

        <div class="flex items-center gap-2 md:gap-4 w-full">
          <button
            type="button"
            id="lightbox-prev"
            class="shrink-0 p-2 md:p-3 rounded-full bg-background/80 backdrop-blur-md border border-accent/20 text-accent hover:border-accent/60 transition-colors duration-300 cursor-pointer"
            aria-label="Previous screenshot"
          >
            <Icon name="mdi:chevron-left" class="w-5 h-5 md:w-6 md:h-6" />
          </button>

          <div class="flex-1 min-w-0 flex items-center justify-center">
            {items.map((item, index) => (
              <Image
                src={item.src}
                alt={item.alt}
                class={`lightbox-image max-h-[75vh] w-auto max-w-full object-contain rounded-xl ${index === 0 ? '' : 'hidden'}`}
                data-caption={item.caption}
                data-index={index}
              />
            ))}
          </div>

          <button
            type="button"
            id="lightbox-next"
            class="shrink-0 p-2 md:p-3 rounded-full bg-background/80 backdrop-blur-md border border-accent/20 text-accent hover:border-accent/60 transition-colors duration-300 cursor-pointer"
            aria-label="Next screenshot"
          >
            <Icon name="mdi:chevron-right" class="w-5 h-5 md:w-6 md:h-6" />
          </button>
        </div>

        <p class="text-center text-sm font-body text-subtext px-4">
          <span id="lightbox-caption"></span>
          <span id="lightbox-counter" class="text-accent/70 ml-2 font-mono text-xs"></span>
        </p>
      </div>
    </dialog>
  </section>
)}

<style>
  /* The dialog wrapper should not swallow clicks meant for the backdrop */
  #gallery-lightbox::backdrop {
    cursor: pointer;
  }
</style>

<script>
  function initGallery() {
    const dialog = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
    if (!dialog) return;

    const thumbs = document.querySelectorAll<HTMLButtonElement>('.gallery-thumb');
    const slides = dialog.querySelectorAll<HTMLImageElement>('.lightbox-image');
    const caption = document.getElementById('lightbox-caption');
    const counter = document.getElementById('lightbox-counter');
    if (slides.length === 0) return;

    let current = 0;

    function show(index: number) {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle('hidden', i !== current));
      if (caption) caption.textContent = slides[current].dataset.caption || '';
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
    }

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        show(Number(thumb.dataset.index));
        dialog.showModal();
      });
    });

    document.getElementById('lightbox-prev')?.addEventListener('click', () => show(current - 1));
    document.getElementById('lightbox-next')?.addEventListener('click', () => show(current + 1));
    document.getElementById('lightbox-close')?.addEventListener('click', () => dialog.close());

    // Click outside the content closes (the dialog element itself fills the backdrop area)
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    // Esc is handled natively by <dialog>; add arrow-key navigation
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + 1);
      }
    });
  }

  initGallery();
  document.addEventListener('astro:after-swap', initGallery);
</script>
