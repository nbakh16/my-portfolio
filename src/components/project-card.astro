---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { resolveAssetImage, resolveProjectGallery } from '../utils/images';
import type { Project } from '../utils/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Cover image: the explicit override if set, otherwise the first screenshot in the project folder
const gallery = await resolveProjectGallery(project.slug);
const coverImage = project.cover
  ? await resolveAssetImage(`projects/${project.slug}/${project.cover}`)
  : (gallery[0]?.src ?? null);

const hasLink = Boolean(project.link && project.link !== '#');
const hasRepo = Boolean(project.repoUrl && project.repoUrl !== '#');

const categoryColors: Record<string, string> = {
  'Professional Project':      'text-sky-400 bg-sky-400/10 border-sky-400/20',
  'Academic / Thesis Project': 'text-amber-400 bg-amber-400/10 border-amber-400/20',
  'Personal Project':          'text-emerald-400 bg-emerald-400/10 border-emerald-400/20',
  'Published App':             'text-violet-400 bg-violet-400/10 border-violet-400/20',
};
const categoryClass = categoryColors[project.category] ?? 'text-accent bg-accent/10 border-accent/20';

const platformLabels: Record<string, string> = {
  android:   'Android',
  'apple-ios': 'iOS',
  windows:   'Windows',
  web:       'Web',
  linux:     'Linux',
  macos:     'macOS',
};

const platformIconMap: Record<string, string> = {
  android:   'mdi:android',
  'apple-ios': 'mdi:apple-ios',
  windows:   'mdi:microsoft-windows',
  web:       'mdi:web',
  linux:     'mdi:linux',
  macos:     'mdi:apple',
};
---

<div class="project-card group relative bg-accent/5 border border-accent/10 rounded-2xl overflow-hidden hover:border-accent/40 transition-all duration-500 flex flex-col">

  <!-- Image area -->
  <div class="aspect-video overflow-hidden relative bg-background/50 shrink-0">
    {
      coverImage ? (
        <Image
          src={coverImage}
          alt={`${project.title}`}
          class="absolute inset-0 w-full h-full object-cover transition-all duration-1000 group-hover:scale-110"
        />
      ) : (
        <img
          src="/placeholder.jpeg"
          alt={`${project.title} placeholder`}
          class="absolute inset-0 w-full h-full object-cover transition-all duration-1000 group-hover:scale-110"
        />
      )
    }

    <!-- Platform icons -->
    <div class="absolute top-3 right-3 flex gap-2 z-20">
      {project.platforms.map((p: string) => (
        <div
          class="p-1.5 bg-background/80 backdrop-blur-md rounded-lg border border-accent/10 text-maintext"
          title={platformLabels[p] ?? p}
        >
          <Icon name={platformIconMap[p] ?? `mdi:${p}`} class="w-4 h-4" />
        </div>
      ))}
    </div>
  </div>

  <!-- Card body -->
  <div class="p-6 flex flex-col gap-3 flex-1">
    <div>
      <span class={`inline-block text-[10px] uppercase tracking-widest font-bold px-2 py-0.5 rounded-full border ${categoryClass}`}>
        {project.category}
      </span>
      <h3 class="text-xl font-heading font-bold text-maintext mt-2">{project.title}</h3>
    </div>

    <p class="text-subtext text-sm font-body line-clamp-3 flex-1">
      {project.description}
    </p>

    <!-- Tags -->
    <div class="flex flex-wrap gap-2">
      {project.tech.map((t: string) => (
        <span class="rounded-md text-[10px] px-2 md:px-3 py-1 bg-accent/5 border border-accent/10 text-accent/80 group-hover:border-accent/40 group-hover:text-accent transition-colors duration-300">
          {t}
        </span>
      ))}
    </div>

    <!-- Case Study Button -->
    <a
      href={`/projects/${project.slug}/`}
      class="mt-1 flex items-center justify-center gap-2 w-full py-2 rounded-lg border border-accent/20 text-accent/70 hover:text-accent hover:border-accent/60 hover:bg-accent/5 transition-all duration-300 text-xs font-body font-semibold tracking-wide"
    >
      View case study
      <Icon name="mdi:arrow-right" class="w-3.5 h-3.5" />
    </a>

    <!-- Secondary external links -->
    {(hasLink || hasRepo) && (
      <div class="flex items-center justify-center gap-5">
        {hasLink && (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-[11px] font-body text-subtext hover:text-accent transition-colors duration-300"
          >
            <Icon name="mdi:open-in-new" class="w-3.5 h-3.5" />
            Live site
          </a>
        )}
        {hasRepo && (
          <a
            href={project.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-[11px] font-body text-subtext hover:text-accent transition-colors duration-300"
          >
            <Icon name="mdi:github" class="w-3.5 h-3.5" />
            Source
          </a>
        )}
      </div>
    )}
  </div>
</div>

<style is:global>
  .project-card {
    opacity: 0;
    visibility: hidden;
    transform: translateY(40px);
    transition:
      opacity 0.8s ease-out,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.8s;
    will-change: transform, opacity;
  }

  .project-card.reveal {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) !important;
  }
</style>
